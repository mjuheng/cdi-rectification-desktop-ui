{
  "name": "cdi-rectification-desktop-ui",
  "version": "1.0.0",
  "description": "CDI 整改落实桌面端 UI 项目",
  "homepage": "https://github.com/your-username/cdi-rectification-desktop-ui",
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com"
  },
  "main": "main.js",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "electron:serve": "cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "vue-cli-service build && electron-builder --win",
    "electron:build:mac": "vue-cli-service build && electron-builder --mac",
    "electron:build:linux": "vue-cli-service build && electron-builder --linux",
    "electron:build:linux:deb": "vue-cli-service build && electron-builder --linux deb",
    "electron:build:linux:deb:x64": "vue-cli-service build && electron-builder --linux deb --x64",
    "electron:build:linux:deb:arm64": "vue-cli-service build && electron-builder --linux deb --arm64",
    "electron:build:all": "vue-cli-service build && electron-builder --mac --win --linux",
    "electron:build:docker:linux:deb:arm64": "docker run --rm -v ${PWD}:/project -w /project electronuserland/builder:wine node /project/node_modules/.bin/electron-builder --linux deb --arm64",
    "electron:build:wsl:linux:deb:arm64": "wsl npm run electron:build:linux:deb:arm64",
    "start:all": "concurrently \"npm run serve\" \"wait-on http://localhost:8080 && cross-env NODE_ENV=development electron .\""
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "autofit.js": "^3.2.8",
    "core-js": "^3.8.3",
    "dotenv": "^17.2.2",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lowdb": "^7.0.1",
    "path-browserify": "^1.0.1",
    "tdesign-vue": "1.14.1",
    "vue": "^2.6.14",
    "vue-router": "^3.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-plugin-vuex": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "babel-eslint": "^10.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "electron-reloader": "^1.2.3",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "less": "^4.4.1",
    "less-loader": "^12.3.0",
    "vue-template-compiler": "^2.6.14",
    "wait-on": "^9.0.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "build": {
    "appId": "com.example.vue2app",
    "productName": "整改落实",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "main.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "portable",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-v${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-v${version}-linux-${arch}.${ext}",
      "category": "Utility",
      "maintainer": "Your Name <your.email@example.com>"
    }
  }
}
